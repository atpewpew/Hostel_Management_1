# JWT Secret Key - Used for signing and verifying JWT tokens
JWT_SECRET=your-secret-key-here

# Database Connection
MONGO_URI=mongodb://localhost:27017/hostelia

# Server Port
PORT=3000

# Frontend URL for CORS (optional on Vercel same-domain Services)
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# Node Environment (set to production on Vercel)
NODE_ENV=development

# Set to true only if you want Swagger UI (/api-docs) enabled in production
ENABLE_SWAGGER=false

# Redis / Upstash configuration (supports Upstash REST or REDIS_URL)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Email Configuration for OTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cloudinary configuration (required in production / Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
